{{!
    @template mod_playerland/manage_questions

    Question management listing for a PlayerLand activity.

    Example context (json):
    {
        "addurl": "https://example.com/mod/playerland/manage_questions.php?id=2&action=add",
        "addquestionlabel": "Add question",
        "hasquestions": true,
        "noquestionslabel": "No questions have been added yet.",
        "questioncolumnlabel": "Question",
        "topiccolumnlabel": "Linked to",
        "actionscolumnlabel": "Actions",
        "questions": [
            {
                "questiontext": "What is 2 + 2?",
                "topiclabel": "General pool",
                "editurl": "https://example.com/mod/playerland/manage_questions.php?id=2&action=edit&qid=5",
                "deleteurl": "https://example.com/mod/playerland/manage_questions.php?id=2&action=delete&qid=5&sesskey=abc",
                "editicon": "<img alt=\"Edit\" src=\"t/edit\">",
                "deleteicon": "<img alt=\"Delete\" src=\"t/delete\">",
                "confirmdelete": "Are you sure you want to delete this question?"
            }
        ],
        "backurl": "https://example.com/mod/playerland/view.php?id=2",
        "backlabel": "Back"
    }
}}
<a href="{{addurl}}" class="btn btn-primary mb-3">{{addquestionlabel}}</a>

{{^hasquestions}}
<div class="alert alert-info" role="alert">{{noquestionslabel}}</div>
{{/hasquestions}}

{{#hasquestions}}
<div class="table-responsive">
    <table class="generaltable">
        <thead>
            <tr>
                <th scope="col">{{questioncolumnlabel}}</th>
                <th scope="col">{{topiccolumnlabel}}</th>
                <th scope="col">{{actionscolumnlabel}}</th>
            </tr>
        </thead>
        <tbody>
            {{#questions}}
            <tr>
                <td>{{{questiontext}}}</td>
                <td>{{topiclabel}}</td>
                <td>
                    <a href="{{editurl}}">{{{editicon}}}</a>
                    <a href="{{deleteurl}}" data-confirm="{{confirmdelete}}">{{{deleteicon}}}</a>
                </td>
            </tr>
            {{/questions}}
        </tbody>
    </table>
</div>
{{/hasquestions}}

<a href="{{backurl}}" class="btn btn-secondary mt-3">{{backlabel}}</a>
