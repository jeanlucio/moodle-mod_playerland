{{!
    @template mod_playerland/view

    Activity page shell for a PlayerLand instance: the manage-questions button,
    the activity intro, the game container, and the first-load controls overlay.
    The Phaser canvas itself is populated client-side by amd/src/game.js.

    Example context (json):
    {
        "hasmanagecapability": true,
        "manageurl": "https://example.com/mod/playerland/manage_questions.php?id=2",
        "managequestionslabel": "Manage questions",
        "hasintro": true,
        "introhtml": "<p>Explore the level and answer questions.</p>",
        "introseen": false,
        "introtitle": "How to play",
        "controls": [
            {"label": "Arrow keys - move"},
            {"label": "Space or Up - jump (hold for a higher jump)"}
        ],
        "gotitlabel": "Got it",
        "configjson": "{\"id\":2,\"assetsurl\":\"https://example.com/mod/playerland/assets\",\"levels\":1,\"map\":\"map_level001.json\",\"targetquestions\":3,\"blocksresolved\":0,\"lessons\":[\"\",\"\",\"\"]}"
    }
}}
{{#hasmanagecapability}}
<div class="mod-playerland-actions">
    <a href="{{manageurl}}" class="btn btn-secondary">{{managequestionslabel}}</a>
</div>
{{/hasmanagecapability}}

{{#hasintro}}
<div class="generalbox intro">{{{introhtml}}}</div>
{{/hasintro}}

<div id="playerland-game-wrapper">
    <div id="playerland-game-container"></div>

    {{^introseen}}
    <div id="playerland-intro" role="dialog" aria-modal="true" aria-labelledby="playerland-intro-title">
        <h2 id="playerland-intro-title">{{introtitle}}</h2>
        <ul class="playerland-intro-list">
            {{#controls}}
            <li>{{label}}</li>
            {{/controls}}
        </ul>
        <button type="button" class="btn btn-primary" id="playerland-intro-dismiss">{{gotitlabel}}</button>
    </div>
    {{/introseen}}
</div>

<script type="application/json" id="mod-playerland-config">{{{configjson}}}</script>
